# 复制本文件为 .env 后使用。.env 含密码，已被 .gitignore 忽略，不要提交到 Git。

CONTROL_PORT=8088
CONTROL_ACCOUNTS_JSON={"admin":"admin123"}
CONTROL_SESSION_TTL_SECONDS=43200
HOST_PROJECT_PATH=/volume1/docker/nas_game_server

MC_IMAGE=itzg/minecraft-server:stable-java25
TYPE=NEOFORGE
VERSION=26.2
NEOFORGE_VERSION=26.2.0.62
NEOFORGE_INSTALLER=/installer/neoforge-26.2.0.62-installer.jar
# Minecraft Java 堆。20 GB NAS 独占时用 14G，还要开 Terraria 或其他套件时用 12G。资源说明见 README「推荐配置」。
MEMORY=14G
MC_GAME_PORT=25566
TZ=Asia/Shanghai
BACKUP_INTERVAL_SECONDS=259200
BACKUP_CHECK_INTERVAL_SECONDS=3600
PROXY=
PUID=1000
PGID=1000
MOTD=Synology NeoForge 26.2 Server
MAX_PLAYERS=10
DIFFICULTY=normal
VIEW_DISTANCE=10
SIMULATION_DISTANCE=8
ENABLE_WHITELIST=FALSE
WHITELIST=
OPS=
ONLINE_MODE=TRUE
ENFORCE_SECURE_PROFILE=TRUE
EULA=TRUE

# Palworld. The internal admin password is used only by the controller
# through the container-internal REST client.
PALWORLD_IMAGE=thijsvanloef/palworld-server-docker:latest
PALWORLD_PORT=8211
PALWORLD_QUERY_PORT=27015
PALWORLD_PLAYERS=16
PALWORLD_SERVER_NAME=Synology Palworld Server
PALWORLD_SERVER_DESCRIPTION=Palworld dedicated server on Synology NAS
PALWORLD_SERVER_PASSWORD=
PALWORLD_ADMIN_PASSWORD=admin123
PALWORLD_COMMUNITY=false
PALWORLD_CROSSPLAY_PLATFORMS=(Steam,Xbox,PS5,Mac)
PALWORLD_DIFFICULTY=None
PALWORLD_EXP_RATE=1.0
PALWORLD_CAPTURE_RATE=1.0
PALWORLD_PVP=false
PALWORLD_FRIENDLY_FIRE=false
PALWORLD_DEATH_PENALTY=All
PALWORLD_EGG_HATCH_TIME=72.0
PALWORLD_AUTO_SAVE_SPAN=30.0

# Terraria / TShock. 世界大小：1 小、2 中、3 大；难度：0 普通、1 专家、2 大师、3 旅途。
TERRARIA_IMAGE=ghcr.io/pryaxis/tshock:stable
TERRARIA_PORT=7777
TERRARIA_REST_PORT=7878
TERRARIA_WORLD_NAME=nas-world
TERRARIA_WORLD_SIZE=2
TERRARIA_DIFFICULTY=1
TERRARIA_MAX_PLAYERS=8
TERRARIA_SERVER_PASSWORD=
TERRARIA_REST_TOKEN=admin123
TERRARIA_MOTD=Synology Terraria Server

# Project Zomboid Build 42
PZ_IMAGE=faudil/project-zomboid-server:latest
PZ_PORT=16261
PZ_STEAM_PORT=16262
PZ_STEAM_PORT_2=16263
PZ_RCON_HOST_PORT=27016
PZ_SERVER_NAME=nas-zomboid
PZ_PUBLIC_NAME=Synology Project Zomboid Server
PZ_PUBLIC_SERVER=true
PZ_SERVER_PASSWORD=
PZ_ADMIN_PASSWORD=admin123
PZ_RCON_PASSWORD=admin123
PZ_MAX_PLAYERS=8
# Project Zomboid Java 堆，可选 4096m / 6144m / 8192m。不要与 Minecraft 或帕鲁同时开。
PZ_MAX_RAM=6144m
PZ_PVP=true
PZ_PAUSE_ON_EMPTY=true
PZ_STEAM_VAC=true
PZ_MAP_NAMES=Muldraugh, KY
PZ_AUTOSAVE_INTERVAL=15
PZ_SANDBOX_MODE=apocalypse
PZ_MOD_WORKSHOP_IDS=
PZ_MOD_NAMES=
